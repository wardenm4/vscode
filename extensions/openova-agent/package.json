{
  "name": "openova-agent",
  "displayName": "Openova Agent",
  "description": "Openova's built-in AI coding agent — chat, autonomous runs, plans, checkpoints, MCP.",
  "version": "0.0.1",
  "publisher": "openova",
  "license": "MIT",
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Agent runs that execute commands or write files require a trusted workspace."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openova",
          "title": "Openova",
          "icon": "media/nova.svg"
        }
      ]
    },
    "views": {
      "openova": [
        {
          "type": "webview",
          "id": "openova.chat",
          "name": "Agent",
          "icon": "media/nova.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "openova.newAgent",
        "title": "Openova: New Agent"
      },
      {
        "command": "openova.focusChat",
        "title": "Openova: Focus Chat"
      },
      {
        "command": "openova.openAgentsWindow",
        "title": "Openova: Open Agents Window",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "openova.inlineEdit",
        "title": "Openova: Inline Edit Selection"
      }
    ],
    "keybindings": [
      {
        "command": "openova.focusChat",
        "key": "ctrl+l",
        "mac": "cmd+l"
      },
      {
        "command": "openova.openAgentsWindow",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "openova.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openova.openAgentsWindow",
          "when": "view == openova.chat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Openova",
      "properties": {
        "openova.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "openrouter",
            "mistral",
            "opencode",
            "lmstudio",
            "ollama",
            "openai-compatible"
          ],
          "default": "ollama",
          "description": "AI provider for chat and agent runs."
        },
        "openova.model": {
          "type": "string",
          "default": "qwen3.5:9b",
          "description": "Model id (discovered models are offered in the picker)."
        },
        "openova.reasoningEffort": {
          "type": "string",
          "enum": [
            "off",
            "low",
            "medium",
            "high",
            "max"
          ],
          "default": "off",
          "description": "Reasoning effort for models that support it (off disables thinking on local models)."
        },
        "openova.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL override for the active provider."
        },
        "openova.checkCommand": {
          "type": "string",
          "default": "",
          "description": "Optional command (typecheck/lint/test) the agent must pass before finishing."
        },
        "openova.tabCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Ghost-text tab completions from the configured model (Tab to accept)."
        },
        "openova.mcpServers": {
          "type": "array",
          "default": [],
          "description": "MCP servers available to the agent (stdio). Each entry: { \"name\": \"docs\", \"command\": \"npx some-mcp-server\" }.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:openova-agent",
    "watch": "gulp watch-extension:openova-agent"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wardenm4/vscode.git"
  }
}
