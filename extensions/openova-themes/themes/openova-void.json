{
	"$schema": "vscode://schemas/color-theme",
	"name": "Openova Void",
	"type": "dark",
	"semanticHighlighting": true,
	"colors": {
		"focusBorder": "#3b82f6",
		"selection.background": "#3b82f655",
		"activityBar.background": "#050507",
		"activityBar.foreground": "#e8eaed",
		"activityBar.inactiveForeground": "#5c626b",
		"activityBar.activeBorder": "#3b82f6",
		"activityBarBadge.background": "#3b82f6",
		"activityBarBadge.foreground": "#ffffff",
		"sideBar.background": "#0a0a0e",
		"sideBar.foreground": "#a9adb5",
		"sideBar.border": "#17171d",
		"sideBarTitle.foreground": "#6b7079",
		"sideBarSectionHeader.background": "#0a0a0e",
		"editor.background": "#050507",
		"editor.foreground": "#e8eaed",
		"editor.lineHighlightBackground": "#0a0a0e",
		"editor.selectionBackground": "#3b82f63d",
		"editorCursor.foreground": "#3b82f6",
		"editorLineNumber.foreground": "#3a3d44",
		"editorLineNumber.activeForeground": "#7d828b",
		"editorIndentGuide.background1": "#14141a",
		"editorGroupHeader.tabsBackground": "#050507",
		"tab.activeBackground": "#0a0a0e",
		"tab.inactiveBackground": "#050507",
		"tab.activeBorderTop": "#3b82f6",
		"tab.border": "#17171d",
		"tab.inactiveForeground": "#5c626b",
		"tab.activeForeground": "#e8eaed",
		"titleBar.activeBackground": "#050507",
		"titleBar.activeForeground": "#a9adb5",
		"titleBar.border": "#17171d",
		"statusBar.background": "#0a0a0e",
		"statusBar.foreground": "#6b7079",
		"statusBar.border": "#17171d",
		"statusBar.noFolderBackground": "#0a0a0e",
		"statusBar.debuggingBackground": "#3b82f6",
		"statusBarItem.remoteBackground": "#3b82f6",
		"statusBarItem.remoteForeground": "#ffffff",
		"button.background": "#3b82f6",
		"button.foreground": "#ffffff",
		"button.hoverBackground": "#5093f7",
		"button.secondaryBackground": "#14141a",
		"button.secondaryForeground": "#e8eaed",
		"badge.background": "#3b82f6",
		"badge.foreground": "#ffffff",
		"progressBar.background": "#3b82f6",
		"input.background": "#0d0d12",
		"input.border": "#1b1b22",
		"input.foreground": "#e8eaed",
		"inputOption.activeBorder": "#3b82f6",
		"dropdown.background": "#0d0d12",
		"dropdown.border": "#1b1b22",
		"list.activeSelectionBackground": "#191920",
		"list.activeSelectionForeground": "#f4f5f7",
		"list.inactiveSelectionBackground": "#14141a",
		"list.hoverBackground": "#101016",
		"list.highlightForeground": "#3b82f6",
		"panel.background": "#0a0a0e",
		"panel.border": "#17171d",
		"panelTitle.activeBorder": "#3b82f6",
		"terminal.background": "#0a0a0e",
		"quickInput.background": "#101016",
		"pickerGroup.foreground": "#3b82f6",
		"textLink.foreground": "#5093f7",
		"textLink.activeForeground": "#7db0f9",
		"notificationCenterHeader.background": "#101016",
		"notifications.background": "#101016",
		"widget.shadow": "#000000aa",
		"editorWidget.background": "#101016",
		"editorWidget.border": "#1b1b22",
		"editorSuggestWidget.selectedBackground": "#191920",
		"scrollbarSlider.background": "#ffffff12",
		"scrollbarSlider.hoverBackground": "#ffffff22",
		"scrollbarSlider.activeBackground": "#ffffff33",
		"minimap.selectionHighlight": "#3b82f655",
		"gitDecoration.modifiedResourceForeground": "#5093f7",
		"gitDecoration.untrackedResourceForeground": "#3ecf8e",
		"gitDecoration.deletedResourceForeground": "#f0716a",
		"charts.green": "#3ecf8e",
		"charts.blue": "#3b82f6",
		"charts.orange": "#e0a458",
		"menu.background": "#101016",
		"menu.border": "#1b1b22",
		"menu.selectionBackground": "#191920",
		"editorHoverWidget.background": "#101016",
		"editorHoverWidget.border": "#1b1b22"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#565b64", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "string.quoted"],
			"settings": { "foreground": "#3ecf8e" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": { "foreground": "#e0a458" }
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
			"settings": { "foreground": "#5093f7" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
			"settings": { "foreground": "#7db0f9" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
			"settings": { "foreground": "#4fd6b8" }
		},
		{
			"scope": ["variable", "meta.definition.variable.name"],
			"settings": { "foreground": "#e8eaed" }
		},
		{
			"scope": ["variable.other.property", "support.variable.property"],
			"settings": { "foreground": "#b7c2d0" }
		},
		{
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#f0716a" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#e0a458" }
		},
		{
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#6b7079" }
		},
		{
			"scope": ["markup.heading"],
			"settings": { "foreground": "#5093f7", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		}
	]
}
